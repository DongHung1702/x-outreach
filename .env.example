# Copy to .env and fill in. Never commit .env.

# --- X (required for live mode; leave empty to run the offline demo) ---
# From your app in the X developer console: "Keys and tokens" -> OAuth 2.0 Client ID / Secret.
X_CLIENT_ID=
X_CLIENT_SECRET=

# --- Claude (recommended; without it a simple rule-based scorer/drafter is used) ---
ANTHROPIC_API_KEY=
# OUTREACH_LLM_MODEL=claude-haiku-5-5
# Used only for the on-screen cost meter (USD per million tokens). Set to your model's price.
# LLM_INPUT_PRICE_PER_MTOK=1.0
# LLM_OUTPUT_PRICE_PER_MTOK=5.0

# --- Guardrails ---
# DAILY_SEND_CAP=20
# MIN_SECONDS_BETWEEN_SENDS=90
# INBOX_SYNC_MINUTES=15

# --- App ---
# OUTREACH_MODE=auto        # auto | live | demo
# OUTREACH_BASE_URL=http://127.0.0.1:8000   # must match the callback registered on X
# OUTREACH_DB=data/outreach.db
